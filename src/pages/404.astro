---
import { Image } from 'astro:assets';
import { RichText } from '@inzumer/ui-library';
import errorImage from '@assets/error.png';
import { ButtonLink } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import {
  DEFAULT_LOCALE,
  LOCALES,
  localizedPath,
  notFoundLanguageScript,
  SITE_BASE,
  trackingId,
} from '@utils';

// One static 404 for every URL: both languages are rendered and the one matching the URL prefix
// is shown (Spanish by default, and without JavaScript).
const messages = LOCALES.map((lang) => ({
  lang,
  text: getTranslations(lang, 'common')['not-found'],
  home: localizedPath(lang, 'home'),
}));
const title = getTranslations(DEFAULT_LOCALE, 'common')['not-found'].title;
---

<PageLayout lang={DEFAULT_LOCALE} title={title} noindex>
  {messages.map(({ lang, text, home }) => (
    <section
      data-not-found={lang}
      lang={lang}
      hidden={lang !== DEFAULT_LOCALE}
      class="flex flex-col items-center gap-4 py-12 text-center"
    >
      <Image
        src={errorImage}
        alt=""
        width={256}
        height={256}
        loading="eager"
        class="size-48 sm:size-64"
      />
      <RichText as="p" variant="h1" bold className="font-display text-7xl text-[var(--text-link)]">
        404
      </RichText>
      <RichText variant="h1" bold className="font-display">
        {text.title}
      </RichText>
      <RichText variant="p1" className="text-[var(--text-secondary)]">
        {text.description}
      </RichText>
      <ButtonLink id={trackingId('not-found', 'link', 'home')} href={home} size="lg">
        {text['back-home']}
      </ButtonLink>
    </section>
  ))}
  <script
    is:inline
    set:html={notFoundLanguageScript({ locales: LOCALES, base: SITE_BASE })}
  ></script>
</PageLayout>
