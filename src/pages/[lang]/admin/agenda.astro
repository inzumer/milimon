---
import { AgendaPanel } from '@components';
import { getTranslations } from '@i18n';
import PanelPage from '@layouts/panel-page.astro';
import { localePaths, localizedPath, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const admin = getTranslations(lang, 'admin-page');
const page = getTranslations(lang, 'agenda-page');
---

<PanelPage lang={lang} title={page.title} description={page.description} management>
  <AgendaPanel
    client:load
    lang={lang}
    labels={page}
    accessLabels={admin}
    loginHref={localizedPath(lang, 'login')}
  />
</PanelPage>
