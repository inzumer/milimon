---
import { RichText } from '@inzumer/ui-library';
import { AgendaPanel } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const admin = getTranslations(lang, 'admin-page');
const page = getTranslations(lang, 'agenda-page');
---

<PageLayout
  lang={lang}
  title={page.title}
  description={page.description}
  noindex
  breadcrumbs={[
    { label: common.nav.home, href: localizedPath(lang, 'home') },
    { label: common.nav['site-group'], href: localizedPath(lang, 'admin') },
  ]}
>
  <div class="flex flex-col gap-8">
    <header class="flex flex-col gap-3">
      <RichText variant="h1" bold className="font-display text-5xl">
        {page.title}
      </RichText>
      <RichText variant="p1" className="text-[var(--text-secondary)]">
        {page.description}
      </RichText>
    </header>
    <AgendaPanel
      client:load
      lang={lang}
      labels={page}
      accessLabels={admin}
      loginHref={localizedPath(lang, 'login')}
    />
  </div>
</PageLayout>
