---
import { AgendaPanel } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, localizedPath, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const admin = getTranslations(lang, 'admin-page');
const page = getTranslations(lang, 'agenda-page');
---

<PageLayout
  lang={lang}
  title={page.title}
  description={page.description}
  noindex
  breadcrumbs={[{ label: common.nav['site-group'], href: localizedPath(lang, 'admin') }]}
>
  <div class="flex flex-col gap-8">
    <PageHeader title={page.title} intro={page.description} />
    <AgendaPanel
      client:load
      lang={lang}
      labels={page}
      accessLabels={admin}
      loginHref={localizedPath(lang, 'login')}
    />
  </div>
</PageLayout>
