---
import { getCollection } from 'astro:content';
import { RichText } from '@inzumer/ui-library';
import { AdminGate } from '@components';
import { ADMIN_DOCS, DOCS_REPO_URL } from '@constants';
import { getTranslations } from '@i18n';
import PanelPage from '@layouts/panel-page.astro';
import { adaptDocHtml, LOCALES, localizedPath, toLocale, trackingId } from '@utils';

export const getStaticPaths = async () => {
  const entries = await getCollection('suggestions');
  const pages = Object.fromEntries(ADMIN_DOCS.map(({ id, file }) => [file, id]));

  return LOCALES.flatMap((lang) =>
    ADMIN_DOCS.map(({ id, file }) => {
      const entry = entries.find((item) => item.id === file);
      if (!entry?.rendered) {
        throw new Error(`Missing suggestion document: docs/suggestions/${file}.md`);
      }

      const html = adaptDocHtml(entry.rendered.html, {
        pages,
        repoUrl: DOCS_REPO_URL,
        folder: 'suggestions',
      });

      return { params: { lang, doc: id }, props: { id, html } };
    }),
  );
};

interface Props {
  id: (typeof ADMIN_DOCS)[number]['id'];
  html: string;
}

const { id, html } = Astro.props;
const lang = toLocale(Astro.params.lang);
const admin = getTranslations(lang, 'admin-page');
const page = getTranslations(lang, 'admin-docs');
const doc = page.docs[id];
---

<PanelPage
  lang={lang}
  title={doc.title}
  description={doc.description}
  management
  parents={[{ label: page.title, href: localizedPath(lang, 'admin', 'suggestions') }]}
>
  <Fragment slot="header">
    {lang !== 'es' && (
      <RichText variant="p3" className="text-[var(--text-secondary)] italic">
        {page['language-note']}
      </RichText>
    )}
  </Fragment>
  <AdminGate client:load labels={admin} loginHref={localizedPath(lang, 'login')}>
    <article class="doc-prose" lang="es" set:html={html} />
    <a
      id={trackingId('admin-docs', 'link', 'back')}
      href={localizedPath(lang, 'admin', 'suggestions')}
      class="mt-10 inline-flex font-semibold text-[var(--text-link)] underline hover:text-[var(--text-link-hover)]"
    >
      ← {page.back}
    </a>
  </AdminGate>
</PanelPage>
