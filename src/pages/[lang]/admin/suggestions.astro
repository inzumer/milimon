---
import { RichText } from '@inzumer/ui-library';
import { AdminGate } from '@components';
import { ADMIN_DOCS } from '@constants';
import { getTranslations } from '@i18n';
import PanelPage from '@layouts/panel-page.astro';
import { localePaths, localizedPath, toLocale, trackingId } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const admin = getTranslations(lang, 'admin-page');
const page = getTranslations(lang, 'admin-docs');
---

<PanelPage lang={lang} title={page.title} description={page.description} management>
  <AdminGate client:load labels={admin} loginHref={localizedPath(lang, 'login')}>
    <div class="flex flex-col gap-10">
      <ol class="grid gap-4 md:grid-cols-2">
        {ADMIN_DOCS.map(({ id }, index) => (
          <li>
            <a
              id={trackingId('admin-docs', 'link', id)}
              href={localizedPath(lang, 'admin', 'suggestions', id)}
              class="flex h-full flex-col gap-1 rounded-xl border border-[var(--border-default)] bg-[var(--surface-primary)] p-5 text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--border-strong)] hover:bg-[var(--surface-secondary)] focus-visible:ring-2 focus-visible:ring-[var(--border-focus)] focus-visible:outline-none"
            >
              <RichText as="span" variant="s4" bold className="text-[var(--text-accent)]">
                {String(index + 1).padStart(2, '0')}
              </RichText>
              <RichText as="span" variant="s1" bold>
                {page.docs[id].title}
              </RichText>
              <RichText as="span" variant="p3" className="text-[var(--text-secondary)]">
                {page.docs[id].description}
              </RichText>
            </a>
          </li>
        ))}
      </ol>
      <section class="flex flex-col gap-3">
        <RichText variant="h2" className="text-3xl">
          {page['order-title']}
        </RichText>
        <ol class="flex list-decimal flex-col gap-2 pl-6">
          {page.order.map((step) => (
            <li>
              <RichText as="span">{step}</RichText>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </AdminGate>
</PanelPage>
