---
import { RichText } from '@inzumer/ui-library';
import { AnalyticsPreference } from '@components';
import { getTranslations } from '@i18n';
import LegalPage from '@layouts/legal-page.astro';
import { isContainerId } from '@services';
import { localePaths, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'privacy-page');
const analyticsEnabled = isContainerId(import.meta.env.PUBLIC_GTM_ID);
---

<LegalPage lang={lang} page={page}>
  {analyticsEnabled ? (
    <AnalyticsPreference slot="your-choice" client:visible labels={common.consent} />
  ) : (
    <RichText slot="your-choice" className="text-[var(--text-secondary)]">
      {page['analytics-disabled']}
    </RichText>
  )}
</LegalPage>
