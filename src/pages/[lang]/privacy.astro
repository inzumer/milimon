---
import { Breadcrumbs, RichText } from '@inzumer/ui-library';
import { AnalyticsPreference } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { isContainerId } from '@services';
import { LOCALES, localizedPath, toLocale } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'privacy-page');
const breadcrumbs = getTranslations(lang, 'formula-page').breadcrumbs;
const analyticsEnabled = isContainerId(import.meta.env.PUBLIC_GTM_ID);
---

<PageLayout lang={lang} title={page.title} description={page.description}>
  <Breadcrumbs
    aria-label={breadcrumbs.label}
    items={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
    current={page.title}
    className="mb-6"
  />
  <article class="flex max-w-2xl flex-col gap-8">
    <header class="flex flex-col gap-3">
      <RichText variant="h1" bold className="font-display text-5xl">
        {page.title}
      </RichText>
      <RichText variant="p1" className="text-[var(--text-secondary)]">
        {page.description}
      </RichText>
      <RichText variant="p3" className="text-[var(--text-secondary)]">
        {page.updated}
      </RichText>
    </header>
    {Object.entries(page.sections).map(([key, section]) => (
      <section id={key} class="flex scroll-mt-24 flex-col gap-3">
        <RichText variant="h2" bold className="font-display text-3xl">
          {section.heading}
        </RichText>
        {section.paragraphs.map((paragraph) => (
          <RichText>{paragraph}</RichText>
        ))}
        {key === 'your-choice' &&
          (analyticsEnabled ? (
            <AnalyticsPreference client:visible label={page['preference-label']} />
          ) : (
            <RichText className="text-[var(--text-secondary)]">
              {page['analytics-disabled']}
            </RichText>
          ))}
      </section>
    ))}
  </article>
</PageLayout>
