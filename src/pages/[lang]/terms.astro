---
import { RichText } from '@inzumer/ui-library';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'terms-page');
---

<PageLayout lang={lang} title={page.title} description={page.description} breadcrumbs={[]}>
  <article class="flex max-w-2xl flex-col gap-8">
    <PageHeader title={page.title} intro={page.description}>
      <RichText variant="p3" className="text-[var(--text-secondary)]">
        {page.updated}
      </RichText>
    </PageHeader>
    {Object.entries(page.sections).map(([key, section]) => (
      <section id={key} class="flex scroll-mt-24 flex-col gap-3">
        <RichText variant="h2" bold className="font-display text-3xl">
          {section.heading}
        </RichText>
        {section.paragraphs.map((paragraph) => (
          <RichText>{paragraph}</RichText>
        ))}
      </section>
    ))}
  </article>
</PageLayout>
