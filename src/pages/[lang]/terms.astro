---
import { getTranslations } from '@i18n';
import LegalPage from '@layouts/legal-page.astro';
import { localePaths, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
---

<LegalPage lang={lang} page={getTranslations(lang, 'terms-page')} />
