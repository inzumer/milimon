---
import { RichText } from '@inzumer/ui-library';
import { ButtonLink, FeatureCard } from '@components';
import BrandIllustration from '@components/atoms/BrandIllustration/brand-illustration.astro';
import { BLOG_ARTICLE_IDS, getBlogArticle, getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, localizedPath, toLocale, trackingId, websiteSchema } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const home = getTranslations(lang, 'home');
const comingSoon = getTranslations(lang, 'coming-soon');
const website = websiteSchema({
  site: Astro.site ?? Astro.url,
  homeHref: localizedPath(lang, 'home'),
  aboutHref: localizedPath(lang, 'about'),
  name: common['app-name'],
  description: common.meta.description,
  lang,
});
const blog = getTranslations(lang, 'blog');
---

<PageLayout lang={lang} structuredData={[website]}>
  <section class="flex flex-col items-center gap-4 pb-10 text-center">
    <BrandIllustration
      name="logo"
      alt={home.hero['logo-alt']}
      width={224}
      class="size-56"
      loading="eager"
      fetchpriority="high"
    />
    <RichText variant="h1" bold className="font-display text-5xl">
      {common['app-name']}
    </RichText>
    <RichText variant="p1" className="max-w-xl text-[var(--text-secondary)]">
      {home.hero.subtitle}
    </RichText>
  </section>

  <section aria-labelledby="management" class="flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <RichText variant="h2" bold id="management" className="font-display text-3xl">
        {home['management-section'].title}
      </RichText>
      <RichText className="text-[var(--text-secondary)]">
        {home['management-section'].intro}
      </RichText>
    </header>
    <FeatureCard
      highlighted
      title={home['calculator-card'].title}
      description={home['calculator-card'].description}
      cta={home['calculator-card'].cta}
      href={localizedPath(lang, 'calculator')}
      ctaId={trackingId('home', 'link', 'calculator')}
    />
    <div class="grid gap-6 lg:grid-cols-2">
      <FeatureCard
        title={home['formulas-card'].title}
        description={home['formulas-card'].description}
        cta={home['formulas-card'].cta}
        href={localizedPath(lang, 'formulas')}
        ctaId={trackingId('home', 'link', 'formulas')}
      />
      <FeatureCard
        title={home['learn-card'].title}
        description={home['learn-card'].description}
        cta={home['learn-card'].cta}
        href={localizedPath(lang, 'learn')}
        ctaId={trackingId('home', 'link', 'learn')}
      />
    </div>
  </section>

  <section aria-labelledby="recipes" class="mt-12 flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <RichText variant="h2" bold id="recipes" className="font-display text-3xl">
        {home['recipes-section'].title}
      </RichText>
      <RichText className="text-[var(--text-secondary)]">{home['recipes-section'].intro}</RichText>
    </header>
    <div class="flex flex-col items-center gap-6 rounded-xl border border-[var(--border-default)] bg-[var(--surface-primary)] p-6 text-center shadow-sm sm:flex-row sm:text-left">
      <BrandIllustration name="star" alt={comingSoon['star-alt']} width={112} class="size-28" />
      <div class="flex flex-col items-center gap-3 sm:items-start">
        <RichText
          as="p"
          variant="s4"
          bold
          className="rounded-full bg-primary-500 px-3 py-1 tracking-wide text-neutral-950 uppercase"
        >
          {comingSoon.badge}
        </RichText>
        <RichText className="text-[var(--text-secondary)]">
          {home['recipes-card'].description}
        </RichText>
        <ButtonLink
          id={trackingId('home', 'link', 'recipes-blog')}
          href={localizedPath(lang, 'blog')}
        >
          {home['recipes-card'].cta}
        </ButtonLink>
      </div>
    </div>
  </section>

  <section aria-labelledby="blog" class="mt-12 flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <RichText variant="h2" bold id="blog" className="font-display text-3xl">
        {home['blog-section'].title}
      </RichText>
      <RichText className="text-[var(--text-secondary)]">{home['blog-section'].intro}</RichText>
    </header>
    <div class="grid gap-6 lg:grid-cols-2">
      {BLOG_ARTICLE_IDS.map((id) => {
        const article = getBlogArticle(lang, id);
        return (
          <FeatureCard
            badge={common.nav.featured}
            title={article.title}
            description={article.description}
            cta={blog.index['read-more']}
            href={localizedPath(lang, 'blog', id)}
            ctaId={trackingId('home', 'link', 'blog', id)}
          />
        );
      })}
    </div>
  </section>

  <section aria-labelledby="about" class="mt-12 flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <RichText variant="h2" bold id="about" className="font-display text-3xl">
        {home['about-section'].title}
      </RichText>
      <RichText className="text-[var(--text-secondary)]">{home['about-section'].intro}</RichText>
    </header>
    <FeatureCard
      title={home['about-card'].title}
      description={home['about-card'].description}
      cta={home['about-card'].cta}
      href={localizedPath(lang, 'about')}
      ctaId={trackingId('home', 'link', 'about')}
    />
  </section>

  <section aria-labelledby="account" class="mt-12 flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <RichText variant="h2" bold id="account" className="font-display text-3xl">
        {home['account-section'].title}
      </RichText>
      <RichText className="text-[var(--text-secondary)]">{home['account-section'].intro}</RichText>
    </header>
    <FeatureCard
      title={home['account-card'].title}
      description={home['account-card'].description}
      cta={home['account-card'].cta}
      href={localizedPath(lang, 'login')}
      ctaId={trackingId('home', 'link', 'sign-in')}
    />
  </section>
</PageLayout>
