---
import { Breadcrumbs } from '@inzumer/ui-library';
import { LoginPanel } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'login-page');
const breadcrumbs = getTranslations(lang, 'formula-page').breadcrumbs;
---

<PageLayout lang={lang} title={page.title} description={page.description} noindex>
  <Breadcrumbs
    aria-label={breadcrumbs.label}
    items={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
    current={page.title}
    className="mb-6"
  />
  <div class="flex max-w-2xl flex-col gap-8">
    <header class="flex flex-col gap-3">
      <h1 class="text-5xl">{page.title}</h1>
      <p class="text-lg text-[var(--text-secondary)]">{page.description}</p>
    </header>
    <LoginPanel
      client:load
      lang={lang}
      labels={page.panel}
      migrationLabels={common.migration}
      accountHref={localizedPath(lang, 'account')}
      termsHref={localizedPath(lang, 'terms')}
      privacyHref={localizedPath(lang, 'privacy')}
    />
  </div>
</PageLayout>
