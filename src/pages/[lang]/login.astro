---
import { LoginPanel } from '@components';
import { getTranslations } from '@i18n';
import PanelPage from '@layouts/panel-page.astro';
import { localePaths, localizedPath, toLocale } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'login-page');
---

<PanelPage lang={lang} title={page.title} description={page.description} narrow>
  <LoginPanel
    client:load
    lang={lang}
    labels={page.panel}
    migrationLabels={common.migration}
    accountHref={localizedPath(lang, 'account')}
    termsHref={localizedPath(lang, 'terms')}
    privacyHref={localizedPath(lang, 'privacy')}
  />
</PanelPage>
