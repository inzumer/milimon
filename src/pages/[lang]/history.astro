---
import { HistoryList } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getFormulaTranslation, getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { readAccountConfig } from '@services';
import { localePaths, localizedPath, toLocale } from '@utils';
import { FORMULA_IDS } from '@utils/formulas';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'history-page');
const ui = getTranslations(lang, 'calculator');
const formulas = Object.fromEntries(
  FORMULA_IDS.map((id) => {
    const text = getFormulaTranslation(lang, id);

    return [id, { title: text.title, outputs: text.outputs }];
  }),
);
const accountHref = readAccountConfig(import.meta.env) ? localizedPath(lang, 'login') : undefined;
---

<PageLayout
  ogSection="management"
  lang={lang}
  title={page.title}
  description={page.description}
  noindex
  breadcrumbs={[]}
>
  <PageHeader title={page.title} intro={page.description} class="mb-8" />
  <HistoryList
    client:load
    lang={lang}
    labels={page.list}
    ui={ui}
    formulas={formulas}
    calculatorHref={localizedPath(lang, 'calculator')}
    accountHref={accountHref}
  />
</PageLayout>
