---
import { FeatureCard } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { getBlogIndex } from '@services/content';
import { interpolate, localePaths, localizedPath, toLocale, trackingId } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const blog = getTranslations(lang, 'blog');
const dateFormat = new Intl.DateTimeFormat(lang === 'es' ? 'es-AR' : 'en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const articles = await getBlogIndex(lang);
---

<PageLayout
  ogSection="blog"
  lang={lang}
  title={blog.index.title}
  description={blog.index.description}
  breadcrumbs={[]}
>
  <PageHeader title={blog.index.title} intro={blog.index.intro} class="mb-8" />
  <ul class="grid gap-6 lg:grid-cols-2">
    {articles.map((article) => (
      <li>
        <FeatureCard
          headingLevel="h2"
          title={article.title}
          description={`${interpolate(blog.index.published, {
            date: dateFormat.format(article.date),
          })} · ${article.description}`}
          cta={blog.index['read-more']}
          href={localizedPath(lang, 'blog', article.id)}
          ctaId={trackingId('blog', 'link', article.id)}
        />
      </li>
    ))}
  </ul>
</PageLayout>
