---
import { RichText } from '@inzumer/ui-library';
import { ButtonLink } from '@components';
import { INSTITUTE_URL } from '@constants';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, localizedPath, profilePageSchema, toLocale, trackingId } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'about-page');
const profile = profilePageSchema({
  site: Astro.site ?? Astro.url,
  aboutHref: localizedPath(lang, 'about'),
  description: page.description,
  lang,
});
---

<PageLayout
  lang={lang}
  title={page.title}
  description={page.description}
  breadcrumbs={[]}
  structuredData={[profile]}
>
  <article class="flex flex-col gap-10">
    <header class="flex flex-col gap-4">
      <RichText variant="h1" bold className="font-display text-5xl">
        {page.title}
      </RichText>
      {page.intro.map((paragraph) => (
        <RichText variant="p1">{paragraph}</RichText>
      ))}
    </header>

    <section aria-labelledby="studies" class="flex flex-col gap-4">
      <RichText variant="h2" bold id="studies" className="font-display text-3xl">
        {page['studies-title']}
      </RichText>
      <ul class="flex flex-col gap-4">
        {page.studies.map((study) => (
          <li class="flex flex-col gap-2 rounded-xl border border-[var(--border-default)] p-5">
            <RichText variant="h3" className="text-xl font-bold">
              {study.title}
            </RichText>
            <RichText className="text-[var(--text-secondary)]">{study.description}</RichText>
          </li>
        ))}
      </ul>
      <a
        id={trackingId('about', 'link', 'institute')}
        href={INSTITUTE_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-6 items-center self-start font-semibold text-[var(--text-link)] underline"
      >
        {page['institute-link']}
      </a>
    </section>

    <section aria-labelledby="why" class="flex flex-col gap-4">
      <RichText variant="h2" bold id="why" className="font-display text-3xl">
        {page['why-title']}
      </RichText>
      {page.why.map((paragraph) => (
        <RichText>{paragraph}</RichText>
      ))}
      <div class="flex flex-wrap gap-3">
        <ButtonLink id={trackingId('about', 'link', 'blog')} href={localizedPath(lang, 'blog')}>
          {page['blog-cta']}
        </ButtonLink>
        <ButtonLink
          id={trackingId('about', 'link', 'calculator')}
          href={localizedPath(lang, 'calculator')}
          variant="secondary"
        >
          {page['calculator-cta']}
        </ButtonLink>
      </div>
    </section>
  </article>
</PageLayout>
