---
import { Breadcrumbs, RichText } from '@inzumer/ui-library';
import {
  ButtonLink,
  FormulaCalculator,
  OmnesCalculator,
  RecipeCostingCalculator,
} from '@components';
import { getFormulaTranslation, getTranslations, toCalculatorText } from '@i18n';
import StudyNotes from '@layouts/formula/study-notes.astro';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale, trackingId } from '@utils';
import { FORMULA_IDS, formulasByGroup, getFormula } from '@utils/formulas';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => FORMULA_IDS.map((formula) => ({ params: { lang, formula } })));
}

const lang = toLocale(Astro.params.lang);
const formula = getFormula(Astro.params.formula as (typeof FORMULA_IDS)[number]);
const text = getFormulaTranslation(lang, formula.id);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'formula-page');
const ui = getTranslations(lang, 'calculator');
const { study } = text;
const calculatorText = toCalculatorText(text);
const related = formulasByGroup()[formula.group].filter((item) => item.id !== formula.id);
const section = (key: string) => `section-${key}`;
---

<PageLayout ogSection="management" lang={lang} title={text.title} description={text.summary}>
  <Breadcrumbs
    aria-label={page.breadcrumbs.label}
    items={[
      { label: common.nav.home, href: localizedPath(lang, 'home') },
      { label: common.nav.formulas, href: localizedPath(lang, 'formulas') },
    ]}
    current={text.title}
    className="mb-6"
  />

  <article class="flex flex-col gap-12">
    <header class="flex flex-col gap-3">
      <RichText variant="p3" className="font-bold tracking-wide text-[var(--text-link)] uppercase">
        {page.groups[formula.group]}
      </RichText>
      <RichText variant="h1" bold className="font-display text-5xl">
        {text.title}
      </RichText>
      <RichText variant="p1" className="max-w-2xl text-[var(--text-secondary)]">
        {text.summary}
      </RichText>
      <ButtonLink
        id={trackingId(formula.id, 'link', 'try-calculator')}
        href={`#${section('calculator')}`}
        className="mt-2 self-start"
      >
        {page['try-calculator']}
      </ButtonLink>
    </header>

    <section aria-labelledby={section('what')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('what')} className="font-display text-3xl">
        {page.sections.what}
      </RichText>
      {study.what.map((paragraph) => (
        <RichText className="max-w-3xl leading-relaxed">{paragraph}</RichText>
      ))}
    </section>

    <section aria-labelledby={section('formula')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('formula')} className="font-display text-3xl">
        {page.sections.formula}
      </RichText>
      <ul class="flex flex-col gap-2 rounded-xl border-2 border-[rgb(var(--color-primary-500))] bg-[var(--surface-secondary)] p-5 text-lg font-semibold">
        {study.formula.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby={section('variables')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('variables')} className="font-display text-3xl">
        {page.sections.variables}
      </RichText>
      <dl class="grid gap-4 lg:grid-cols-2">
        {study.variables.map((variable) => (
          <div class="rounded-lg border border-[var(--border-default)] p-4">
            <dt class="font-bold">{variable.name}</dt>
            <dd class="text-[var(--text-secondary)]">{variable.description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby={section('steps')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('steps')} className="font-display text-3xl">
        {page.sections.steps}
      </RichText>
      <ol class="flex max-w-3xl list-decimal flex-col gap-2 pl-6 marker:font-bold">
        {study.steps.map((step) => (
          <li class="pl-1 leading-relaxed">{step}</li>
        ))}
      </ol>
    </section>

    <section aria-labelledby={section('examples')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('examples')} className="font-display text-3xl">
        {page.sections.examples}
      </RichText>
      {study.examples.map((example) => (
        <div class="flex flex-col gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-primary)] p-5">
          <RichText variant="h3" className="text-xl font-bold">
            {example.title}
          </RichText>
          {example.paragraphs.map((paragraph) => (
            <RichText className="leading-relaxed tabular-nums">{paragraph}</RichText>
          ))}
        </div>
      ))}
    </section>

    <section aria-labelledby={section('notes')} class="flex flex-col gap-4">
      <RichText variant="h2" bold id={section('notes')} className="font-display text-3xl">
        {page.sections.notes}
      </RichText>
      <StudyNotes notes={study.notes} labels={page.notes} />
    </section>

    <section
      id={section('calculator')}
      aria-labelledby={`${section('calculator')}-title`}
      class="flex scroll-mt-24 flex-col gap-4"
    >
      <RichText
        variant="h2"
        bold
        id={`${section('calculator')}-title`}
        className="font-display text-3xl"
      >
        {page.sections.calculator}
      </RichText>
      {formula.layout === 'standard' && (
        <FormulaCalculator
          client:visible
          formulaId={formula.id}
          lang={lang}
          text={calculatorText}
          ui={ui}
        />
      )}
      {formula.id === 'omnes-rules' && (
        <OmnesCalculator client:visible lang={lang} text={calculatorText} ui={ui} />
      )}
      {formula.id === 'recipe-costing' && (
        <RecipeCostingCalculator client:visible lang={lang} text={calculatorText} ui={ui} />
      )}
    </section>

    {related.length > 0 && (
      <nav aria-labelledby={section('related')} class="flex flex-col gap-4">
        <RichText variant="h2" bold id={section('related')} className="font-display text-3xl">
          {page.sections.related}
        </RichText>
        <ul class="flex flex-col gap-2">
          {related.map((item) => (
            <li>
              <a
                href={localizedPath(lang, 'formulas', item.id)}
                class="text-lg font-semibold underline underline-offset-4"
              >
                {getFormulaTranslation(lang, item.id).title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</PageLayout>
