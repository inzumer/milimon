---
import { RichText } from '@inzumer/ui-library';
import { FeatureCard } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getFormulaTranslation, getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, localizedPath, toLocale, trackingId } from '@utils';
import { FORMULA_GROUPS, formulasByGroup } from '@utils/formulas';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'formula-page');
const groups = formulasByGroup();
---

<PageLayout
  ogSection="management"
  lang={lang}
  title={page.index.title}
  description={page.index.intro}
  breadcrumbs={[]}
>
  <PageHeader title={page.index.title} intro={page.index.intro} class="mb-10" />

  <div class="flex flex-col gap-12">
    {FORMULA_GROUPS.map((group) => (
      <section aria-labelledby={`group-${group}`} class="flex flex-col gap-5">
        <RichText variant="h2" bold id={`group-${group}`} className="font-display text-3xl">
          {page.groups[group]}
        </RichText>
        <ul class="grid gap-5 lg:grid-cols-2">
          {groups[group].map((formula) => {
            const text = getFormulaTranslation(lang, formula.id);

            return (
              <li>
                <FeatureCard
                  title={text.title}
                  description={text.summary}
                  cta={page.index.open}
                  href={localizedPath(lang, 'formulas', formula.id)}
                  ctaId={trackingId('formulas', 'link', formula.id)}
                />
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
