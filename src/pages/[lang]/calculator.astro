---
import { CalculatorPicker } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getFormulaTranslation, getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, toLocale } from '@utils';
import { FORMULA_GROUPS, formulasByGroup } from '@utils/formulas';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'calculator-page');
const formulaPage = getTranslations(lang, 'formula-page');
const ui = getTranslations(lang, 'calculator');
const byGroup = formulasByGroup();
const groups = FORMULA_GROUPS.map((group) => ({
  group,
  label: formulaPage.groups[group],
  formulas: byGroup[group].map((formula) => ({
    id: formula.id,
    title: getFormulaTranslation(lang, formula.id).title,
  })),
}));
---

<PageLayout
  ogSection="management"
  lang={lang}
  title={page.title}
  description={page.intro}
  breadcrumbs={[]}
>
  <PageHeader title={page.title} intro={page.intro} class="mb-8" />
  <CalculatorPicker client:load lang={lang} groups={groups} page={page} ui={ui} />
</PageLayout>
