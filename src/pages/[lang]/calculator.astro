---
import { RichText } from '@inzumer/ui-library';
import { CalculatorPicker } from '@components';
import { getFormulaTranslation, getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale } from '@utils';
import { FORMULA_GROUPS, formulasByGroup } from '@utils/formulas';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'calculator-page');
const formulaPage = getTranslations(lang, 'formula-page');
const ui = getTranslations(lang, 'calculator');
const byGroup = formulasByGroup();
// Only titles travel to the island; each formula's texts are loaded when it's picked.
const groups = FORMULA_GROUPS.map((group) => ({
  group,
  label: formulaPage.groups[group],
  formulas: byGroup[group].map((formula) => ({
    id: formula.id,
    title: getFormulaTranslation(lang, formula.id).title,
  })),
}));
---

<PageLayout
  ogSection="management"
  lang={lang}
  title={page.title}
  description={page.intro}
  breadcrumbs={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
>
  <header class="mb-8 flex flex-col gap-3">
    <RichText variant="h1" bold className="font-display text-5xl">
      {page.title}
    </RichText>
    <RichText variant="p1" className="max-w-2xl text-[var(--text-secondary)]">
      {page.intro}
    </RichText>
  </header>
  <CalculatorPicker client:load lang={lang} groups={groups} page={page} ui={ui} />
</PageLayout>
