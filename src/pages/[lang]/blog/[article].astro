---
import { getImage } from 'astro:assets';
import BlogPost from '@components/organisms/BlogPost/blog-post.astro';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { getBlogIndex, getPublishedPosts } from '@services/content';
import { blogPostingSchema, localeIdPaths, localizedPath, toLocale, withBase } from '@utils';

export const getStaticPaths = async () =>
  localeIdPaths(
    'article',
    (await getBlogIndex('es')).map(({ id }) => id),
  )();

const lang = toLocale(Astro.params.lang);
const id = Astro.params.article;
const item = (await getBlogIndex(lang)).find((entry) => entry.id === id);
const post = (await getPublishedPosts()).find((entry) => entry.id === id);
if (!item || !post) {
  throw new Error(`Unknown article: ${id}`);
}

const blog = getTranslations(lang, 'blog');
const site = Astro.site ?? Astro.url;
const aboutHref = localizedPath(lang, 'about');
const published = item.date.toISOString().slice(0, 10);
const cover = post.data.cover
  ? (await getImage({ src: post.data.cover, width: 1200, format: 'webp' })).src
  : withBase(`/og/og-blog-${lang}.png`);
const posting = blogPostingSchema({
  site,
  url: new URL(localizedPath(lang, 'blog', item.id), site).href,
  aboutHref,
  title: item.title,
  description: item.description,
  datePublished: published,
  image: new URL(cover, site).href,
  lang,
});
---

<PageLayout
  ogSection="blog"
  lang={lang}
  title={item.title}
  structuredData={[posting]}
  article={{ publishedTime: published, authorUrl: new URL(aboutHref, site).href }}
  description={item.description}
  breadcrumbs={[{ label: blog.index.title, href: localizedPath(lang, 'blog') }]}
>
  <div class="max-w-3xl">
    <BlogPost post={post} lang={lang} />
  </div>
</PageLayout>
