---
import { Breadcrumbs } from '@inzumer/ui-library';
import { AccountPanel } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { readAccountConfig } from '@services';
import { LOCALES, localizedPath, toLocale } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'account-page');
const breadcrumbs = getTranslations(lang, 'formula-page').breadcrumbs;
const accountsEnabled = readAccountConfig(import.meta.env) !== null;
const path = localizedPath(lang, 'account');
---

<PageLayout lang={lang} title={page.title} description={page.description} noindex>
  <Breadcrumbs
    aria-label={breadcrumbs.label}
    items={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
    current={page.title}
    className="mb-6"
  />
  <div class="flex max-w-2xl flex-col gap-8">
    <header class="flex flex-col gap-3">
      <h1 class="text-5xl">{page.title}</h1>
      <p class="text-lg text-[var(--text-secondary)]">{page.description}</p>
    </header>
    {accountsEnabled ? (
      <AccountPanel client:load labels={page.panel} returnPath={path} />
    ) : (
      <p class="rounded-lg bg-[var(--surface-secondary)] p-4">{page.disabled}</p>
    )}
    <p class="text-sm text-[var(--text-secondary)]">
      {page['privacy-note']}{' '}
      <a
        href={localizedPath(lang, 'privacy')}
        class="font-semibold text-[var(--text-link)] underline"
      >
        {page['privacy-link']}
      </a>
      .
    </p>
  </div>
</PageLayout>
