---
import { RichText } from '@inzumer/ui-library';
import { AccountPanel, CurrencySelect, SectionLabel } from '@components';
import { getTranslations } from '@i18n';
import PanelPage from '@layouts/panel-page.astro';
import { localePaths, localizedPath, toLocale, trackingId } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'account-page');
---

<PanelPage lang={lang} title={page.title} description={page.description} narrow>
  <AccountPanel
    client:load
    labels={page.panel}
    migrationLabels={common.migration}
    unavailableLabel={page.disabled}
    loginHref={localizedPath(lang, 'login')}
  />
  <section aria-labelledby="account-settings" class="flex flex-col gap-4">
    <SectionLabel id="account-settings">{page.settings.title}</SectionLabel>
    <CurrencySelect
      client:load
      lang={lang}
      label={page.settings.currency}
      hint={page.settings['currency-hint']}
    />
  </section>
  <RichText variant="p3" className="text-[var(--text-secondary)]">
    {page['privacy-note']}{' '}
    <a
      id={trackingId('account', 'link', 'privacy')}
      href={localizedPath(lang, 'privacy')}
      class="font-semibold text-[var(--text-link)] underline"
    >
      {page['privacy-link']}
    </a>
    .
  </RichText>
</PanelPage>
