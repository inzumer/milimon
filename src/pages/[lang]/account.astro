---
import { RichText } from '@inzumer/ui-library';
import { AccountPanel } from '@components';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale, trackingId } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'account-page');
---

<PageLayout
  lang={lang}
  title={page.title}
  description={page.description}
  noindex
  breadcrumbs={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
>
  <div class="flex max-w-2xl flex-col gap-8">
    <header class="flex flex-col gap-3">
      <RichText variant="h1" bold className="font-display text-5xl">
        {page.title}
      </RichText>
      <RichText variant="p1" className="text-[var(--text-secondary)]">
        {page.description}
      </RichText>
    </header>
    <AccountPanel
      client:load
      labels={page.panel}
      migrationLabels={common.migration}
      unavailableLabel={page.disabled}
      loginHref={localizedPath(lang, 'login')}
    />
    <RichText variant="p3" className="text-[var(--text-secondary)]">
      {page['privacy-note']}{' '}
      <a
        id={trackingId('account', 'link', 'privacy')}
        href={localizedPath(lang, 'privacy')}
        class="font-semibold text-[var(--text-link)] underline"
      >
        {page['privacy-link']}
      </a>
      .
    </RichText>
  </div>
</PageLayout>
