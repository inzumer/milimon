---
import { FeatureCard } from '@components';
import PageHeader from '@components/molecules/PageHeader/page-header.astro';
import { getLearnTopic, getTranslations, LEARN_TOPIC_IDS } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localePaths, localizedPath, toLocale, trackingId } from '@utils';

export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const page = getTranslations(lang, 'learn-page');
---

<PageLayout
  ogSection="management"
  lang={lang}
  title={page.index.title}
  description={page.index.intro}
  breadcrumbs={[]}
>
  <PageHeader title={page.index.title} intro={page.index.intro} class="mb-10" />
  <ol class="grid gap-5 lg:grid-cols-2">
    {LEARN_TOPIC_IDS.map((id) => {
      const topic = getLearnTopic(lang, id);

      return (
        <li>
          <FeatureCard
            headingLevel="h2"
            title={topic.title}
            description={topic.summary}
            cta={page.index.open}
            href={localizedPath(lang, 'learn', id)}
            ctaId={trackingId('learn', 'link', id)}
          />
        </li>
      );
    })}
  </ol>
</PageLayout>
