---
import { Breadcrumbs, RichText } from '@inzumer/ui-library';
import { FeatureCard } from '@components';
import { getLearnTopic, getTranslations, LEARN_TOPIC_IDS } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale, trackingId } from '@utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'learn-page');
const breadcrumbs = getTranslations(lang, 'formula-page').breadcrumbs;
---

<PageLayout lang={lang} title={page.index.title} description={page.index.intro}>
  <Breadcrumbs
    aria-label={breadcrumbs.label}
    items={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
    current={page.index.title}
    className="mb-6"
  />
  <header class="mb-10 flex flex-col gap-3">
    <RichText variant="h1" bold className="font-display text-5xl">
      {page.index.title}
    </RichText>
    <RichText variant="p1" className="max-w-2xl text-[var(--text-secondary)]">
      {page.index.intro}
    </RichText>
  </header>
  <ol class="grid gap-5 lg:grid-cols-2">
    {LEARN_TOPIC_IDS.map((id) => {
      const topic = getLearnTopic(lang, id);
      return (
        <li>
          <FeatureCard
            headingLevel="h2"
            title={topic.title}
            description={topic.summary}
            cta={page.index.open}
            href={localizedPath(lang, 'learn', id)}
            ctaId={trackingId('learn', 'link', id)}
          />
        </li>
      );
    })}
  </ol>
</PageLayout>
