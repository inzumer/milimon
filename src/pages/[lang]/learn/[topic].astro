---
import { Breadcrumbs, RichText } from '@inzumer/ui-library';
import { FeatureCard } from '@components';
import {
  adjacentTopics,
  getFormulaTranslation,
  getLearnTopic,
  getTranslations,
  LEARN_TOPIC_IDS,
  LEARN_TOPICS,
  type LearnTopicId,
} from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { LOCALES, localizedPath, toLocale, trackingId } from '@utils';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => LEARN_TOPIC_IDS.map((topic) => ({ params: { lang, topic } })));
}

const lang = toLocale(Astro.params.lang);
const id = Astro.params.topic as LearnTopicId;
const topic = getLearnTopic(lang, id);
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'learn-page');
const formulaPage = getTranslations(lang, 'formula-page');
const related = LEARN_TOPICS.find((item) => item.id === id)?.related ?? [];
const { previous, next } = adjacentTopics(id);
---

<PageLayout lang={lang} title={topic.title} description={topic.summary}>
  <Breadcrumbs
    aria-label={formulaPage.breadcrumbs.label}
    items={[
      { label: common.nav.home, href: localizedPath(lang, 'home') },
      { label: common.nav.learn, href: localizedPath(lang, 'learn') },
    ]}
    current={topic.title}
    className="mb-6"
  />

  <article class="flex flex-col gap-10">
    <header class="flex flex-col gap-3">
      <RichText variant="h1" bold className="font-display text-5xl">
        {topic.title}
      </RichText>
      <RichText variant="p1" className="max-w-2xl text-[var(--text-secondary)]">
        {topic.summary}
      </RichText>
    </header>

    {topic.sections.map((section, index) => (
      <section aria-labelledby={`section-${index}`} class="flex max-w-3xl flex-col gap-3">
        <RichText variant="h2" bold id={`section-${index}`} className="font-display text-3xl">
          {section.heading}
        </RichText>
        {section.paragraphs?.map((paragraph) => (
          <RichText className="leading-relaxed">{paragraph}</RichText>
        ))}
        {section.items && (
          <ul class="flex list-disc flex-col gap-2 pl-6 marker:text-[var(--text-link)]">
            {section.items.map((item) => (
              <li class="pl-1 leading-relaxed">{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <section aria-labelledby="related-formulas" class="flex flex-col gap-5">
      <RichText variant="h2" bold id="related-formulas" className="font-display text-3xl">
        {page['related-formulas']}
      </RichText>
      <ul class="grid gap-5 lg:grid-cols-2">
        {related.map((formulaId) => {
          const formula = getFormulaTranslation(lang, formulaId);
          return (
            <li>
              <FeatureCard
                title={formula.title}
                description={formula.summary}
                cta={formulaPage.index.open}
                href={localizedPath(lang, 'formulas', formulaId)}
                ctaId={trackingId(id, 'link', formulaId)}
              />
            </li>
          );
        })}
      </ul>
    </section>

    <nav aria-label={page['topic-navigation']} class="flex flex-wrap justify-between gap-4">
      {previous && (
        <a href={localizedPath(lang, 'learn', previous)} class="flex flex-col gap-1 font-semibold">
          <RichText variant="s3" className="text-[var(--text-secondary)]">
            ← {page.previous}
          </RichText>
          {getLearnTopic(lang, previous).title}
        </a>
      )}
      {next && (
        <a
          href={localizedPath(lang, 'learn', next)}
          class="ml-auto flex flex-col gap-1 text-right font-semibold"
        >
          <RichText variant="s3" className="text-[var(--text-secondary)]">
            {page.next} →
          </RichText>
          {getLearnTopic(lang, next).title}
        </a>
      )}
    </nav>
  </article>
</PageLayout>
