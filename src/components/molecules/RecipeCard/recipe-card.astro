---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { MediaCard } from '@inzumer/ui-library';
import { getTranslations } from '@i18n';
import { interpolate, localize, recipeTitle, type Locale } from '@utils';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  lang: Locale;
  href?: string;
}

/** The recipe's cover: photo card with title, category and time. */
const { recipe, lang, href } = Astro.props;
const { data } = recipe;
const text = getTranslations(lang, 'recipe-page');
const photo = data.photo ? await getImage({ src: data.photo, width: 640, format: 'webp' }) : null;
const subtitle = [
  text.categories[data.category],
  data.minutes ? interpolate(text.minutes, { minutes: data.minutes }) : '',
]
  .filter(Boolean)
  .join(' · ');
---

<MediaCard
  {...(photo && { src: photo.src })}
  {...(href && { href })}
  alt={localize(data.photoAlt, lang)}
  title={recipeTitle(data, lang)}
  subtitle={subtitle}
/>
