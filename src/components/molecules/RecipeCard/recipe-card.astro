---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Showcase } from '@inzumer/ui-library';
import { getTranslations } from '@i18n';
import { recipeCardText, trackingId, type Locale } from '@utils';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  lang: Locale;
  href?: string;
}

/** The recipe's cover: photo card with title, category and time. */
const { recipe, lang, href } = Astro.props;
const card = recipeCardText(recipe.data, lang, getTranslations(lang, 'recipe-page'));
const photo = recipe.data.photo
  ? await getImage({ src: recipe.data.photo, width: 640, format: 'webp' })
  : null;
---

<Showcase
  {...(photo && { src: photo.src })}
  {...(href && { href, linkId: trackingId('recipes', 'link', recipe.id) })}
  alt={card.alt}
  title={card.title}
  subtitle={card.subtitle}
/>
