---
import { getImage } from 'astro:assets';
import { RichText } from '@inzumer/ui-library';
import star from '@assets/illustrations/star.webp';
import { MilicitosRating } from '@components';
import BlogHeader from '@components/molecules/BlogHeader/blog-header.astro';
import { getBlogArticle, getTranslations } from '@i18n';
import { interpolate, type Locale } from '@utils';

interface Props {
  lang: Locale;
}

/** The "milicitos" article: how the review scale works. */
const { lang } = Astro.props;
const article = getBlogArticle(lang, 'milicitos');
const blog = getTranslations(lang, 'blog');
const milicito = await getImage({ src: star, width: 64, height: 64, format: 'webp' });
---

<article class="flex flex-col gap-6">
  <BlogHeader
    lang={lang}
    title={article.title}
    description={article.description}
    date={new Date(`${article.date}T12:00:00Z`)}
  />
  {article.intro.map((paragraph) => (
    <RichText>{paragraph}</RichText>
  ))}
  <section aria-labelledby="scale" class="flex flex-col gap-4">
    <RichText variant="h2" bold id="scale" className="font-display text-3xl">
      {article['scale-title']}
    </RichText>
    <ol class="flex flex-col gap-3">
      {article.scale.map((meaning, index) => (
        <li class="flex flex-col gap-2 rounded-xl border border-[var(--border-default)] p-4 sm:flex-row sm:items-center sm:gap-4">
          <MilicitosRating
            rating={index + 1}
            label={interpolate(blog.rating, { count: String(index + 1) })}
            imageSrc={milicito.src}
            className="shrink-0"
          />
          <RichText>{meaning}</RichText>
        </li>
      ))}
    </ol>
  </section>
  <RichText>{article.closing}</RichText>
</article>
