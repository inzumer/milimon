---
import '@styles/global.css';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import lobsterLatin from '@fontsource/lobster-two/files/lobster-two-latin-700-normal.woff2?url';
import { getTranslations } from '@i18n';
import { SETTINGS_STORAGE_KEY } from '@repositories';
import { LOCALES, switchLocalePath, type Locale } from '@utils';

interface Props {
  lang: Locale;
  title?: string | undefined;
  description?: string | undefined;
  /** Keep the page out of search results (404, language redirect). */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const common = getTranslations(lang, 'common');
const pageTitle = title ? `${title} · ${common['app-name']}` : common['app-name'];
const pageDescription = description ?? common.meta.description;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = LOCALES.map((locale) => ({
  hreflang: locale,
  href: new URL(switchLocalePath(Astro.url.pathname, locale), site).href,
}));
const OG_LOCALES: Record<Locale, string> = { es: 'es_AR', en: 'en_US' };
// Share image per language, generated by `pnpm og:image` (scripts/og-image.mjs).
const ogImageUrl = new URL(`/og/og-${lang}.png`, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FDF7F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2F201B" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex &&
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={common['app-name']} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${common['app-name']}: ${common.meta.description}`} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {LOCALES.filter((locale) => locale !== lang).map((locale) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[locale]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lobsterLatin} as="font" type="font/woff2" crossorigin />
    {/*
      Applies the color scheme before the first paint (no flash of the wrong theme).
      Explicit choice from the settings repository wins; otherwise it follows the OS, live.
    */}
    <script is:inline define:vars={{ storageKey: SETTINGS_STORAGE_KEY }}>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = () => {
          try {
            const scheme = JSON.parse(localStorage.getItem(storageKey) || 'null')?.colorScheme;
            return scheme === 'dark' || scheme === 'light' ? scheme : null;
          } catch {
            return null;
          }
        };
        const apply = () => {
          root.dataset.colorScheme = stored() ?? (media.matches ? 'dark' : 'light');
        };
        apply();
        media.addEventListener('change', () => {
          if (!stored()) {
            apply();
          }
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
