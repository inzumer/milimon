---
import { getTranslations } from '@i18n';
import { isContainerId } from '@services';
import { localizedPath, trackingId, type Locale } from '@utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const common = getTranslations(lang, 'common');
const year = new Date().getFullYear();
// Without Tag Manager there are no optional cookies to choose.
const analyticsEnabled = isContainerId(import.meta.env.PUBLIC_GTM_ID);
---

<footer class="mt-16 border-t border-[var(--border-default)] bg-[var(--surface-secondary)]">
  <div class="mx-auto flex w-full max-w-layout flex-col gap-1 px-4 py-8 text-sm text-[var(--text-secondary)]">
    <p class="font-display text-xl font-bold text-[var(--text-primary)]">{common['app-name']}</p>
    <p>{common.footer.tagline}</p>
    <p>{common.footer.source}</p>
    <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span>© {year}</span>
      <a
        id={trackingId('footer', 'link', 'privacy')}
        href={localizedPath(lang, 'privacy')}
        class="inline-flex min-h-6 items-center font-semibold text-[var(--text-link)] underline"
      >
        {common.footer.privacy}
      </a>
      <a
        id={trackingId('footer', 'link', 'terms')}
        href={localizedPath(lang, 'terms')}
        class="inline-flex min-h-6 items-center font-semibold text-[var(--text-link)] underline"
      >
        {common.footer.terms}
      </a>
      {analyticsEnabled && (
        <button
          id={trackingId('footer', 'button', 'cookie-preferences')}
          type="button"
          data-open-cookie-preferences
          class="inline-flex min-h-6 cursor-pointer items-center font-semibold text-[var(--text-link)] underline"
        >
          {common.footer['cookie-preferences']}
        </button>
      )}
    </p>
  </div>
</footer>
