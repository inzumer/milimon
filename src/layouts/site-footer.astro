---
import { getTranslations } from '@i18n';
import type { Locale } from '@utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const common = getTranslations(lang, 'common');
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--border-default)] bg-[var(--surface-secondary)]">
  <div class="mx-auto flex w-full max-w-layout flex-col gap-1 px-4 py-8 text-sm text-[var(--text-secondary)]">
    <p class="font-display text-xl font-bold text-[var(--text-primary)]">{common['app-name']}</p>
    <p>{common.footer.tagline}</p>
    <p>{common.footer.source}</p>
    <p>© {year}</p>
  </div>
</footer>
