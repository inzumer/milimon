---
import type { FormulaTranslation } from '@i18n/formulas';
import type { Translations } from '@i18n/translations';

interface Props {
  notes: FormulaTranslation['study']['notes'];
  labels: Translations<'formula-page'>['notes'];
}

const { notes, labels } = Astro.props;

// Each note type has its own accent so it's recognizable at a glance, never by color alone:
// the type label is always written out.
const accents: Record<(typeof notes)[number]['type'], string> = {
  tip: 'border-l-[rgb(var(--color-success-600))]',
  'common-mistake': 'border-l-[var(--border-error)]',
  rounding: 'border-l-[var(--border-strong)]',
  'manual-difference': 'border-l-[rgb(var(--color-primary-500))]',
};
---

<ul class="flex flex-col gap-4">
  {notes.map((note) => (
    <li
      class={`rounded-lg border border-l-8 border-[var(--border-default)] bg-[var(--surface-secondary)] p-4 ${accents[note.type]}`}
    >
      <p class="mb-1 text-sm font-bold tracking-wide uppercase">{labels[note.type]}</p>
      <p class="leading-relaxed">{note.text}</p>
    </li>
  ))}
</ul>
