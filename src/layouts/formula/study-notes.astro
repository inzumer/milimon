---
import { Card, CardDescription, CardHeader, CardTitle } from '@inzumer/ui-library';
import type { FormulaTranslation } from '@i18n/formulas';
import type { Translations } from '@i18n/translations';

interface Props {
  notes: FormulaTranslation['study']['notes'];
  labels: Translations<'formula-page'>['notes'];
}

const { notes, labels } = Astro.props;
---

<ul class="flex flex-col gap-4">
  {notes.map((note) => (
    <li>
      <Card noPadding>
        <CardHeader className="gap-2">
          <CardTitle as="h3" className="text-sm font-bold tracking-wide uppercase">
            {labels[note.type]}
          </CardTitle>
          <CardDescription className="text-base leading-relaxed text-[var(--text-primary)]">
            {note.text}
          </CardDescription>
        </CardHeader>
      </Card>
    </li>
  ))}
</ul>
