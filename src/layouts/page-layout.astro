---
import { Breadcrumbs } from '@inzumer/ui-library';
import { ConsentBanner, SharePage } from '@components';
import { type OgSection } from '@constants';
import { getTranslations } from '@i18n';
import { isContainerId } from '@services';
import {
  breadcrumbSchema,
  canonicalPath,
  localizedPath,
  type BreadcrumbTrailItem,
  type Locale,
  type StructuredData,
} from '@utils';
import BaseLayout from './base-layout.astro';
import SiteFooter from './site-footer.astro';
import SiteHeader from './site-header.astro';

interface Props {
  lang: Locale;
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean;
  ogSection?: OgSection;
  breadcrumbs?: BreadcrumbTrailItem[];
  structuredData?: StructuredData[];
  article?: { publishedTime: string; authorUrl: string };
}

const {
  lang,
  title,
  description,
  noindex = false,
  ogSection = 'home',
  breadcrumbs,
  structuredData = [],
  article,
} = Astro.props;
const common = getTranslations(lang, 'common');
const analyticsEnabled = isContainerId(import.meta.env.PUBLIC_GTM_ID);
const pathname = canonicalPath(Astro.url.pathname);
const shareUrl = new URL(pathname, Astro.site ?? Astro.url).href;
const shareTitle = title ? `${title} · ${common['app-name']}` : common['app-name'];
const breadcrumbLabel = getTranslations(lang, 'formula-page').breadcrumbs.label;
const schemas = [
  ...(breadcrumbs && title && !noindex
    ? [breadcrumbSchema(Astro.site ?? Astro.url, breadcrumbs, { label: title, url: shareUrl })]
    : []),
  ...structuredData,
];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  noindex={noindex}
  ogSection={ogSection}
  structuredData={schemas}
  article={article}
>
  <a
    href="#main"
    class="sr-only z-50 rounded-lg bg-[var(--btn-primary-bg)] px-4 py-3 font-semibold text-[var(--btn-primary-text)] focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >
    {common['skip-to-content']}
  </a>
  <div class="flex min-h-dvh flex-col">
    <SiteHeader lang={lang} pathname={pathname} />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-layout flex-1 px-4 py-8 focus:outline-none"
    >
      {breadcrumbs && title && (
        <Breadcrumbs
          aria-label={breadcrumbLabel}
          items={breadcrumbs.map(({ label, href }) => ({ label, href }))}
          current={title}
          className="mb-6"
        />
      )}
      <slot />
      {!noindex && (
        <SharePage client:visible url={shareUrl} title={shareTitle} labels={common.share} />
      )}
    </main>
    <SiteFooter lang={lang} />
  </div>
  {analyticsEnabled && (
    <ConsentBanner
      client:load
      labels={common.consent}
      privacyHref={localizedPath(lang, 'privacy')}
    />
  )}
</BaseLayout>

<script>
  import { OPEN_COOKIE_PREFERENCES_EVENT } from '@constants';
  import { getAccountSession, gtmEnvironment, hasStoredSession, startTagManager } from '@services';

  startTagManager(
    import.meta.env.PUBLIC_GTM_ID,
    gtmEnvironment(import.meta.env.PUBLIC_GTM_AUTH, import.meta.env.PUBLIC_GTM_PREVIEW),
  );

  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('[data-open-cookie-preferences]')) {
      window.dispatchEvent(new CustomEvent(OPEN_COOKIE_PREFERENCES_EVENT));
    }
  });

  if (hasStoredSession()) {
    getAccountSession()
      ?.sync.start()
      .catch((error: unknown) => console.warn('[account] could not start', error));
  }
</script>
