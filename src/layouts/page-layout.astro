---
import { ConsentBanner } from '@components';
import { getTranslations } from '@i18n';
import { isContainerId } from '@services';
import { localizedPath, type Locale } from '@utils';
import BaseLayout from './base-layout.astro';
import SiteFooter from './site-footer.astro';
import SiteHeader from './site-header.astro';

interface Props {
  lang: Locale;
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const common = getTranslations(lang, 'common');
// Analytics (and its consent banner) only exist when a GA4 measurement ID is configured.
const analyticsEnabled = isContainerId(import.meta.env.PUBLIC_GTM_ID);
---

<BaseLayout lang={lang} title={title} description={description} noindex={noindex}>
  <a
    href="#main"
    class="sr-only z-50 rounded-lg bg-[var(--btn-primary-bg)] px-4 py-3 font-semibold text-[var(--btn-primary-text)] focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >
    {common['skip-to-content']}
  </a>
  <div class="flex min-h-dvh flex-col">
    <SiteHeader lang={lang} pathname={Astro.url.pathname} />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-layout flex-1 px-4 py-8 focus:outline-none"
    >
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </div>
  {analyticsEnabled && (
    <ConsentBanner
      client:idle
      labels={common.consent}
      privacyHref={localizedPath(lang, 'privacy')}
    />
  )}
</BaseLayout>

<script>
  import { createLocalSettingsRepository } from '@repositories';
  import { getAccountSession, hasStoredSession, startTagManager } from '@services';

  startTagManager(import.meta.env.PUBLIC_GTM_ID, createLocalSettingsRepository());

  // Signed-in people get their profile synced on every page; guests never call the API.
  if (hasStoredSession()) {
    getAccountSession()
      ?.sync.start()
      .catch((error: unknown) => console.warn('[account] could not start', error));
  }
</script>
