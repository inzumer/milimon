---
import { RichText } from '@inzumer/ui-library';
import { ButtonLink } from '@components';
import BrandIllustration from '@components/atoms/BrandIllustration/brand-illustration.astro';
import { getTranslations } from '@i18n';
import PageLayout from '@layouts/page-layout.astro';
import { localizedPath, trackingId, type Locale } from '@utils';

interface Props {
  lang: Locale;
  section: 'recipes';
}

const { lang, section } = Astro.props;
const common = getTranslations(lang, 'common');
const page = getTranslations(lang, 'coming-soon');
const text = page[section];
---

<PageLayout
  ogSection="recipes"
  lang={lang}
  title={text.title}
  description={text.description}
  noindex
  breadcrumbs={[{ label: common.nav.home, href: localizedPath(lang, 'home') }]}
>
  <section class="flex flex-col items-center gap-4 py-6 text-center">
    <BrandIllustration
      name="star"
      alt={page['star-alt']}
      width={224}
      loading="eager"
      class="size-48 sm:size-56"
    />
    <RichText
      as="p"
      variant="s3"
      bold
      className="rounded-full bg-primary-500 px-3 py-1 tracking-wide text-neutral-950 uppercase"
    >
      {page.badge}
    </RichText>
    <RichText variant="h1" bold className="font-display text-5xl">
      {text.title}
    </RichText>
    <RichText variant="p1" className="max-w-xl text-[var(--text-secondary)]">
      {text.description}
    </RichText>
    <RichText className="max-w-xl">{page.meanwhile}</RichText>
    <div class="flex flex-wrap justify-center gap-3">
      <ButtonLink id={trackingId(section, 'link', 'blog')} href={localizedPath(lang, 'blog')}>
        {page['blog-cta']}
      </ButtonLink>
      <ButtonLink
        id={trackingId(section, 'link', 'calculator')}
        href={localizedPath(lang, 'calculator')}
        variant="secondary"
      >
        {page['calculator-cta']}
      </ButtonLink>
    </div>
  </section>
</PageLayout>
