# Public URL of the deployed site: canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL=https://milimon-cost-lab.vercel.app

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to disable analytics and the consent banner.
# GA4 and the click/field triggers (by element id, see docs/TRACKING.md) are configured in the container.
PUBLIC_GTM_ID=

# Supabase (accounts with Google/Facebook). Leave empty to hide the login.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
