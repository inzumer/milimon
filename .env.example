# ─── Site ──────────────────────────────────────────────────────────────────

# Origin of the deployed site: canonical URLs, hreflang, sitemap and Open Graph.
# Production: https://milimon.inzumer.workers.dev
SITE_URL=http://localhost:4321

# Path the site is served under, without trailing slash. Empty locally (served at /).
# Production: / (root)
BASE_PATH=

# ─── Analytics ─────────────────────────────────────────────────────────────

# Google Tag Manager container id. Empty disables analytics and the cookie banner.
# GA4 and the click/field triggers (by element id, see docs/TRACKING.md) live in the container.
PUBLIC_GTM_ID=GTM-EXAMPL3
# Optional GTM environment (staging): gtm_auth and gtm_preview from its snippet.
PUBLIC_GTM_AUTH=
PUBLIC_GTM_PREVIEW=

# ─── Accounts API (milimon-backend-nest) ────────────────────────────────────────────

# Base URL of the API. Empty = /login and /account explain that accounts aren't available yet.
# Production: https://milimon-backend-nest.onrender.com
PUBLIC_API_URL=http://localhost:3000

# Client id and key sent on every request (request-app-id + x-api-key). They ship in the public
# bundle: they identify this client, they are not secrets. Same values as the API's
# WEB_APP_ID and WEB_API_KEY.
PUBLIC_API_APP_ID=web
PUBLIC_API_KEY=example-web-key-8d2f4b6a0c1e3f5a7b9d

# ─── Sign-in providers ─────────────────────────────────────────────────────

# Google OAuth client id (same as the API's GOOGLE_CLIENT_ID). Empty hides the Google button.
PUBLIC_GOOGLE_CLIENT_ID=123456789012-example0example0example0exam.apps.googleusercontent.com

# Facebook app id (same as the API's FACEBOOK_APP_ID). Empty hides the Facebook button.
PUBLIC_FACEBOOK_APP_ID=1234567890123456
