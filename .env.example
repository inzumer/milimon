# Public URL of the deployed site: canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL=https://milimon-cost-lab.vercel.app

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to disable analytics and the consent banner.
# GA4 and the click/field triggers (by element id, see docs/TRACKING.md) are configured in the container.
PUBLIC_GTM_ID=

# Accounts API (api-milimon-cost-lab). Leave PUBLIC_API_URL empty to hide sign-in.
# The key ships in the public bundle: it identifies this client, it is not a secret.
PUBLIC_API_URL=
PUBLIC_API_KEY=
PUBLIC_API_APP_ID=web
# Sign-in providers: each button shows only when its id is set.
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_FACEBOOK_APP_ID=
