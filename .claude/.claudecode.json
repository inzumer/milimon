{
  "$schema": "https://claude.ai/schemas/claudecode.json",
  "project": {
    "name": "milimon-cost-lab",
    "description": "Milimon Cost Lab: bilingual (es/en) study manual and calculators for food cost, waste and cooking loss. Astro static site + React islands on @inzumer/ui-library."
  },
  "context": {
    "maxTokens": 120000,
    "includeGitDiff": true,
    "includeOpenFiles": true,
    "includeDiagnostics": true,
    "includeTerminal": true,
    "includeProblemsPanel": true
  },
  "agents": [
    {
      "name": "workflow-orchestrator",
      "path": "./agents/workflow-orchestrator-agent.md"
    },
    {
      "name": "policy-engine",
      "path": "./agents/policy-engine.md"
    },
    {
      "name": "planner",
      "path": "./agents/planner-agent.md"
    },
    {
      "name": "architect",
      "path": "./agents/architect-agent.md"
    },
    {
      "name": "content-i18n",
      "path": "./agents/content-i18n-agent.md"
    },
    {
      "name": "a11y",
      "path": "./agents/a11y-agent.md"
    },
    {
      "name": "performance",
      "path": "./agents/performance-agent.md"
    },
    {
      "name": "design-system",
      "path": "./agents/design-system-agent.md"
    },
    {
      "name": "task-runner",
      "path": "./agents/task-runner-agent.md"
    },
    {
      "name": "testing-strategy",
      "path": "./agents/testing-strategy-agent.md"
    },
    {
      "name": "documentation",
      "path": "./agents/documentation-agent.md"
    },
    {
      "name": "repository-governance",
      "path": "./agents/repository-governance-agent.md"
    },
    {
      "name": "context-manager",
      "path": "./agents/context-manager-agent.md"
    }
  ],
  "rules": {
    "typescript": {
      "strict": true,
      "forbidAny": true,
      "preferInterfaces": true
    },
    "react": {
      "preferComposition": true,
      "forbidPropDrilling": true,
      "maxComponentLines": 150
    },
    "astro": {
      "staticByDefault": true,
      "preferClientVisible": true
    },
    "imports": {
      "preferAliases": true,
      "forbidDeepRelativeImports": true,
      "allowedAliases": [
        "@components",
        "@calculators",
        "@domain",
        "@repositories",
        "@services",
        "@hooks",
        "@utils",
        "@i18n",
        "@layouts",
        "@assets",
        "@styles",
        "@test",
        "@constants"
      ]
    },
    "i18n": {
      "locales": ["es", "en"],
      "routesInEnglish": true,
      "folderNaming": "kebab-case",
      "requireSameKeys": true,
      "requireDescriptivePlaceholders": true
    },
    "content": {
      "sourceOfTruth": "AyG- Manual.pdf",
      "tone": "study-manual"
    },
    "testing": {
      "minimumCoverage": 90,
      "requireA11yTests": true
    }
  },
  "tools": {
    "terminal": {
      "enabled": true,
      "allow": ["pnpm", "astro", "vitest", "eslint", "prettier", "cspell", "tsc", "git"]
    },
    "browser": {
      "enabled": true,
      "captureConsole": true,
      "captureErrors": true
    }
  },
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "test": "pnpm test",
    "test:coverage": "pnpm test:coverage",
    "format": "pnpm format",
    "spellcheck": "pnpm spellcheck",
    "validate": "pnpm validate"
  },
  "memory": {
    "persistArchitecture": true,
    "persistPatterns": true,
    "persistDesignTokens": true,
    "persistTestingRules": true
  }
}
